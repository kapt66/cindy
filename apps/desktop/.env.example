# Cindy auth-server 区域(默认 Global;中国大陆版显式改成 cn)
VITE_CINDY_AUTH_REGION=global

# ⚠️ 运行期端点不再走 .env(2026-07 端点清单重构):
#   - restart:desktop:remote 默认读仓内 config/endpoint.global.json,
#     --region=cn 时自动改读 config/endpoint.json;
#   - local 模式(pnpm dev:desktop / restart:desktop:local)自动生成并读
#     config/endpoint.local.json(api/auth/device-link 指 localhost);
#   - 想指定其它清单文件:设 XDT_ENDPOINT_MANIFEST_FILE=<路径>;
#   - 想走线上 CDN 清单:启动参数 --endpoints-cdn(或 XDT_ENDPOINTS_CDN=1)。

# Filo Google OAuth desktop client（main-only，不进 renderer，也不要提交实际值）。
# 老版本升级会自动把已安装意识里的旧 client 搬进 safeStorage；全新开发环境和
# 正式构建需要由本机 .env / 发布环境注入。
XDT_FILO_GOOGLE_CLIENT_ID=
XDT_FILO_GOOGLE_CLIENT_SECRET=

# 语音输入模型配置（main-only，不会暴露到 renderer）
# 开发版可用这里作为默认值；安装版会在 userData 下生成 voice-input-models.json。
# 安装版请改那个 JSON 文件，下一次语音输入 / readiness 刷新时生效，不需要重新打包。

# ASR 模型供应商
# 可选：
# - litellm-volcengine-sauc-asr（默认）
# - litellm-qwen3-asr-flash-realtime
# - litellm-gpt-realtime-whisper
# - openai-realtime-whisper
# - litellm-batch
# - elevenlabs-scribe-realtime
XDT_VOICE_INPUT_ASR_PROVIDER=

# 润色模型供应商
# 可选：
# - codex-gpt-5.4-mini（默认）
# - codex-gpt-5.4-nano
# - litellm-gpt-5.4-mini
# - litellm-gpt-5.4-nano
# - litellm-deepseek-v4-flash
# - litellm-qwen3.6-plus
XDT_VOICE_INPUT_REFINER_PROVIDER=

# 高级：保留供应商 profile，只替换实际模型 ID。
# 例如：XDT_VOICE_INPUT_REFINER_PROVIDER=litellm 且这里填 qwen/qwen3.6-plus。
XDT_VOICE_INPUT_REFINER_MODEL=

# Release-machine credentials (never commit real values).
# Public root of the existing Meka update channel. Versioned cn builds require
# this so upgraded clients continue fetching endpoint.json/manifests there.
XDT_CDN_BASE_URL=

# Cindy Meka Desktop RustFS publisher. Prefer putting the non-secret endpoint,
# bucket and prefix in scripts/release-regions.json; this env overrides only
# the S3 endpoint. Credentials must remain on the release machine.
CINDY_MEKA_S3_ENDPOINT=
CINDY_MEKA_RUSTFS_ACCESS_KEY_ID=
CINDY_MEKA_RUSTFS_SECRET_ACCESS_KEY=
# Isolated intranet only: allow the RustFS S3 API endpoint to use HTTP.
CINDY_MEKA_ALLOW_INSECURE_S3=
# Isolated intranet only: allow the packaged update/bootstrap root to use HTTP.
CINDY_MEKA_ALLOW_INSECURE_CDN=

# Meka MCPRouter public service endpoint. Defaults to the existing production
# address so old Meka users see the same prefilled value.
VITE_MEKA_MCPROUTER_URL=

# Windows: the generic command override takes precedence; existing Meka
# release machines can keep using the NPKG signing service token.
CINDY_WIN_SIGN_CMD=
NPKG_TOKEN=

# macOS: use developer-id for notarized public distribution, or self-signed to
# preserve the original Meka certificate identity/keychain and TCC continuity.
# The certificate/private key stay in the macOS keychain.
MAC_SIGNING_MODE=developer-id
APPLE_SIGN_IDENTITY=
APPLE_ID=
APPLE_TEAM_ID=
APPLE_APP_PASSWORD=
