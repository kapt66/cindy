{
    "cn": {
        "oss": {
            "cdnBaseUrl": "",
            "bucket": "cindy-meka-cn",
            "prefix": "cindy-meka",
            "ossRegion": "us-east-1"
        },
        "s3": {
            "endpoint": "https://rustfs.example.com",
